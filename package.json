{
  "name": "bitbucket-datacenter-api-client",
  "version": "1.20.0",
  "description": "TypeScript client for Bitbucket Data Center REST API",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "build": "tsup",
    "docs": "typedoc",
    "docs:check": "typedoc --treatWarningsAsErrors",
    "test": "jest",
    "test:package": "npm run build && node scripts/verify-package.mjs",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "openapi:compare": "node scripts/compare-bitbucket-openapi.mjs",
    "check": "npm run lint && npm run format:check",
    "verify": "npm run check && npm test -- --runInBand && npm run test:package && npm run docs:check"
  },
  "keywords": [
    "bitbucket",
    "bitbucket-server",
    "bitbucket-data-center",
    "api-client",
    "rest"
  ],
  "license": "MIT",
  "homepage": "https://eljijuna.github.io/BitbucketDataCenterApiClient",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElJijuna/BitbucketDataCenterApiClient.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "jest": "^29.7.0",
    "semantic-release": "^25.0.3",
    "super-configs": "^1.16.0",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.4.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.8.3"
  },
  "author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)"
}
